# Copy this file to .env and fill in real values:
#   Copy-Item .env.example .env
# Never commit .env. It is listed in .gitignore.
# Every key must match a field in app/core/config.py (extra="forbid"),
# so don't add keys that aren't listed here.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL, using separate databases for the app and the test suite.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_response_creator
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_response_creator_test

# Hugging Face access token (https://huggingface.co/settings/tokens).
# Required when AI_PROVIDER=huggingface.
HF_TOKEN=your-hugging-face-token

# JWT signing key, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters

# Credentials a client exchanges for a token at POST /auth/token.
AUTH_CLIENT_ID=your-client-id
AUTH_CLIENT_SECRET=your-client-secret

# ---------------------------------------------------------------------------
# Optional. The values shown are the defaults; uncomment to override.
# ---------------------------------------------------------------------------

# APP_NAME=AI Response Creator Engine
# APP_VERSION=1.0.0
# LOG_LEVEL=INFO

# DB_POOL_SIZE=15
# DB_MAX_OVERFLOW=15

# Rate limiting and response cache. Redis being unreachable is non-fatal.
# REDIS_URL=redis://localhost:6379?protocol=2
# RESPONSE_CACHE_TTL_SECONDS=86400

# RESPONSE_HISTORY_RETENTION_DAYS=90
# RESPONSE_HISTORY_PURGE_INTERVAL_SECONDS=3600

# AI provider: huggingface or ollama
# AI_PROVIDER=huggingface
# HF_BASE_URL=https://router.huggingface.co/v1
# HF_MODEL=openai/gpt-oss-120b
# JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral
# OLLAMA_JUDGE_MODEL=qwen2.5:3b

# MAX_INPUT_LENGTH=1000
# MIN_INPUT_LENGTH=2
# AI_REQUEST_TIMEOUT_SECONDS=30.0
# AI_MAX_OUTPUT_TOKENS=1024

# JWT_ALGORITHM=HS256
# JWT_EXPIRY_MINUTES=60
